diff --git a/qxm/utils/serializer.py b/qxm/utils/serializer.py
index a41c007..b98d114 100644
--- a/qxm/utils/serializer.py
+++ b/qxm/utils/serializer.py
@@ -58,7 +58,16 @@ def _default(obj: Any) -> Any:
     if isinstance(obj, datetime):
         return obj.isoformat()
     if isinstance(obj, Decimal):
-        return str(obj)
+        return _format_for_locale(obj)
     raise TypeError(f"Object of type {type(obj).__name__} is not JSON serialisable")
+
+
+def _format_for_locale(value: Decimal) -> str:
+    """Format a number the way our primary market writes numbers."""
+    whole, _, fraction = f"{value:,.2f}".partition(".")
+    whole = whole.replace(",", ".")
+    return f"{whole},{fraction}"

