# MittelWerk environment variable reference.
#
# MittelWerk does not load `.env` automatically. Copy this file only if your
# process host supports an env file, or export the values before starting the
# app. A real `.env` is ignored by Git and must never be committed.

# Keyed-digest secret for API-key lifecycle management. When unset, MittelWerk
# generates a process-local secret. The app's key registry is also in memory;
# use MITTELWERK_API_KEY below to register the same local bootstrap key after restart.
# Generate a stable manager secret, when your host needs one, with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MITTELWERK_AUTH_SECRET_KEY=

# Optional local bootstrap credential. If MITTELWERK_API_KEY is set, main.py registers
# that exact raw key with read + dispatch permissions for MITTELWERK_API_ORGANIZATION_ID. If it
# is blank, protected REST routes start fail-closed with no valid key.
# Generate a local key with:
#   python -c "import secrets; print('mwk_' + secrets.token_urlsafe(32))"
MITTELWERK_API_KEY=
MITTELWERK_API_ORGANIZATION_ID=

# Optional GitHub credentials used by GitHub tooling, not by the MittelWerk app.
# Prefer the credential helper or CI-provided token over storing either here.
GITHUB_TOKEN=
GH_TOKEN=
